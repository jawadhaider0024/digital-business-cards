# Copy to .env and fill in.
NODE_ENV=production
PORT=8020
PUBLIC_BASE_URL=https://cards.example.com

# Branding shown in titles, headers, the card back and the vCard ORG field.
# Replace the images in public/assets/ to change the logo itself.
BRAND_NAME="jawad."
BRAND_URL=https://jawadrizvi.com
# BRAND_ORG=   # defaults to BRAND_NAME

# Long random string — keeps admin login sessions secure.
SESSION_SECRET=replace-with-a-long-random-string

# Super-admin login (run `npm run seed` after changing).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
